# Paperly backend configuration. Copy to .env and fill in GEMINI_API_KEY.

# --- Google Gemini (required for real papers) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# How hard the model thinks when writing/editing papers: low | medium | high
# (higher = better checked answers, but slower)
GEMINI_THINKING_LEVEL=medium

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Papers generated at the same time (the phone only waits on Gemini, so 4 is fine)
MAX_CONCURRENT_GENERATIONS=4
# Largest reference file teachers can upload
MAX_UPLOAD_MB=15

# --- Security ---
# Leave empty: a random key is created automatically in backend/.secret_key
SECRET_KEY=
# Login lasts 30 days
ACCESS_TOKEN_EXPIRE_MINUTES=43200
