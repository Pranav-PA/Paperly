# Paperly Backend Environment Configuration

# Server Settings
APP_NAME=Paperly
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Database (SQLite with WAL mode for Termux / local storage)
DATABASE_URL=sqlite:///./paperly.db

# Storage
UPLOAD_DIR=./uploads
GENERATED_PAPERS_DIR=./generated_papers

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Termux / Concurrency Settings
MAX_CONCURRENT_GENERATIONS=2
